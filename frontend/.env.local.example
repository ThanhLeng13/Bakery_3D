# ===========================================
# Cake Shop AI - Frontend Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values
# cp .env.local.example .env.local

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===========================================
# Đăng nhập Google — cấu hình trên Supabase Dashboard
# ===========================================
# Hai mục này KHÔNG nằm trong file env. Thiếu là nút Google không chạy.
#
# 1) Authentication -> Providers -> Google: bật, và điền Client ID/Secret.
#
# 2) Authentication -> URL Configuration -> Redirect URLs:
#    Phải dùng `**` vì URL callback luôn kèm query (`redirect` và `state`).
#    Khai thiếu thì Supabase KHÔNG báo lỗi — nó im lặng chuyển về Site URL,
#    nên khách quay về trang chủ trong trạng thái chưa đăng nhập.
#
#      https://ten-mien-that.com/auth/callback**
#      http://localhost:3000/auth/callback**
#      https://*-<team-slug>.vercel.app/auth/callback**
#
#    Site URL để riêng, khớp chính xác: https://ten-mien-that.com
#    Tài liệu: https://supabase.com/docs/guides/auth/redirect-urls
